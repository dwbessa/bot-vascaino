# Vasco Digest Bot — grade de execução (America/Sao_Paulo).
# 7 horários: 00, 06, 09, 12, 15, 18, 21. O vão de 6h entre 00h e 06h é
# coberto por MAX_LOOKBACK_HOURS=8 (CA-07): a run das 06:00 alcança 22:00
# do dia anterior, então uma notícia das 02:00 entra no digest das 06:00.
SHELL=/bin/sh
PATH=/app/.venv/bin:/usr/bin:/bin

0 0,6,9,12,15,18,21 * * * vascobot vascobot run >> /app/data/vascobot.log 2>&1
