# =============================================================================
# Vasco Digest Bot — variáveis de ambiente
# Copie para .env e preencha. NUNCA commite o .env.
# =============================================================================

# --- Fontes ------------------------------------------------------------------
SOURCES_ENABLED=netvasco,supervasco
MAX_LOOKBACK_HOURS=8
USER_AGENT="VascoDigestBot/1.0 (+contato@exemplo.com)"

# --- LLM — Ollama Cloud (trocar OLLAMA_HOST se rodar local) ------------------
OLLAMA_HOST=https://ollama.com
OLLAMA_API_KEY=
CLASSIFY_MODEL=gpt-oss:20b-cloud
SUMMARIZE_MODEL=qwen3.5:397b
CLASSIFY_CONFIDENCE_THRESHOLD=0.7
CLASSIFY_BATCH_SIZE=20
INCLUDE_INSTITUTIONAL=true

# --- Bluesky -----------------------------------------------------------------
BLUESKY_ENABLED=true
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
BLUESKY_SESSION_PATH=./data/bsky_session.txt

# --- X (interruptor único — RF-07) -------------------------------------------
X_ENABLED=true
X_CLIENT_ID=
X_CLIENT_SECRET=
X_ACCESS_TOKEN=
X_REFRESH_TOKEN=
X_IS_PREMIUM=true
X_LINK_POLICY=last_post
X_MONTHLY_BUDGET_USD=

# --- Operação ----------------------------------------------------------------
REQUIRE_APPROVAL=true
MAX_POSTS_PER_THREAD=4
DB_PATH=./data/vascobot.db
LOG_LEVEL=INFO
TZ=America/Sao_Paulo
